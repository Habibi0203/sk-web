# Dependensi & hasil build
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# Berkas sementara Vite/TypeScript saat memuat config TS
vite.config.ts.timestamp-*.mjs
*.timestamp-*.mjs

# Log & berkas lokal
*.log
npm-debug.log*
.env
.env.*
*.local

# Kredensial git — JANGAN pernah masuk repositori
.git-credentials
.netrc

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Pemeriksaan lokal yang menunjuk ke folder data pribadi — jangan di-commit
tests/_*.local.test.ts

# ---------------------------------------------------------------- DATA PRIBADI
# PENTING: repositori ini di-push ke GitHub.
# Jangan pernah commit berkas data yang berisi nama orang, nomor STR, atau
# data pribadi dokter. Semua berkas data diproses di browser dan tidak perlu
# masuk ke repositori.
*.xlsx
*.xls
*.xlsm
*.csv
*.docx
*.doc
*.pdf
*.zip

# Pengecualian: fixture sintetis untuk tes boleh masuk (tidak berisi data asli).
!tests/fixtures/**

# Aset bawaan aplikasi WAJIB ikut — berisi acuan layout, bukan data pribadi.
# public/template-default.xlsx = 1 sheet template dengan contoh isi sudah dibuang.
# public/enddates-default.json = hanya angkatan/program/provinsi/tanggal.
!public/template-default.xlsx
